@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<#it>
    a dcat:Dataset ;
    dcterms:title "Cool Cola dataset"@en ;
    dcat:inSeries <../series/products.ttl#it> ;
    dcat:theme schema:Product ;
    dcat:distribution <#dist> .

<#dist>
    a dcat:Distribution ;
    dcat:downloadURL <https://acme-company.solidcommunity.net/public/products/cola.ttl> ;
    dcat:mediaType "text/turtle" .