@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<#it>
    a dcat:Dataset ;
    dcterms:title "Cool Soda dataset"@en ;
    dcat:distribution <#dist> .

<#dist>
    a dcat:Distribution ;
    dcat:downloadURL <https://acme-company.solidcommunity.net/public/products/soda.ttl> ;
    dcat:mediaType "text/turtle" .